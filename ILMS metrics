# Data processing
data = pd.read_excel('*://*** //***.xlsx')
data.drop(['Currency', 'Unit','Batch','Msg Type','Orig-Msg-Type','Status','Sender Ref','System Ref','Cust Ref','Priority','Critical'],axis=1,inplace=True)

# Check whether the drop works
#column_names_list = data.columns.tolist()
