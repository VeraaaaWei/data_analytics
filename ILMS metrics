# Function categorize based on the payment type
# Notice: In the raw data, "FED  Receive/ Send" under the "Payment Type" column means "FED Clearing Receive/ Send"
def categorize(type):
    if 'CHIPS' in type:
        return 'CHIPS'
    elif 'Security' in type:
        return 'SECURITY'
    else:
        return 'FED'
  
# Apply the categorization
data['Category'] = data['Payment Type'].apply(categorize)

#Create new columns based on categories
for Category in ['CHIPS', 'SECURITY', 'FED']:
    data[Category] = data.apply(lambda row: row['Payment Type'] if row['Category'] == Category else '', axis=1)

# Drop the temporary 'Category' column
#data = data.drop('Category', axis=1)

# Function to check if 'send' is in the description
def is_send(text):
    return 'send' in str(text).lower()

# Apply the conversion
data['Amount'] = data.apply(lambda row: -row['Amount'] if is_send(row['Payment Type']) else row['Amount'], axis=1)

# Ensure the data is sorted by timestamp and convert the 'TIME STAMP' column to datetime
data_sorted = data.sort_values(['TIME STAMP'])
data_sorted['TIME STAMP'] = pd.to_datetime(data_sorted['TIME STAMP'])
data_sorted['Period'] = data_sorted['TIME STAMP'].dt.to_period('s')

data_sorted['usageCHIPS'] = data_sorted[data_sorted['Category'] == 'CHIPS'].groupby('Category')['Amount'].transform('cumsum')
data_sorted['usageSECURITY'] = data_sorted[data_sorted['Category'] == 'SECURITY'].groupby('Category')['Amount'].transform('cumsum')
data_sorted['usageFED'] = data_sorted[data_sorted['Category'] == 'FED'].groupby('Category')['Amount'].transform('cumsum')
filtered_FS = data_sorted[data_sorted['Category'].isin(['FED' , 'SECURITY'])]
filtered_FC = data_sorted[data_sorted['Category'].isin(['FED' , 'CHIPS'])]
data_sorted['usageFS'] = filtered_FS['Amount'].transform('cumsum')
data_sorted['usageFC'] = filtered_FC['Amount'].transform('cumsum')

